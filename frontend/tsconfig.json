{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "auth/**/*.ts",
    "auth/**/*.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "admin/**/*.ts",
    "admin/**/*.tsx",
    "shared/**/*.ts",
    "shared/**/*.tsx",
    "types/**/*.d.ts"
  ]
}
