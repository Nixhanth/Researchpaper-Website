# Auto detect text files and perform LF normalization
* text=auto

# Handle line endings of files declared as text
*.java text
*.xml text
*.yml text
*.yaml text
*.md text
*.json text
*.js text
*.ts text
*.tsx text
*.tsx text
*.css text
*.html text

# Forbid CRLF in shell scripts
*.sh text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
